# Render (and Heroku-style PaaS hosts) set NODE_ENV=production before running the build step, and
# npm skips devDependencies under that -- but this project's build (tsc) needs typescript, @types/*
# and sequelize-cli from devDependencies to run at all. Always install them; the compiled dist/
# that actually runs in production never includes devDependencies itself.
include=dev
