# Render (and Heroku-style PaaS hosts) set NODE_ENV=production before running the build step,
# and npm's default behavior is to skip devDependencies whenever NODE_ENV=production is set --
# but this project's build (tsc) needs typescript, @types/*, sequelize-cli etc. from
# devDependencies to run at all. Force npm to always install them regardless of NODE_ENV; the
# compiled dist/ output that actually runs in production never includes devDependencies itself.
production=false
