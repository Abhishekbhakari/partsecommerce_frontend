# --- App ---
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=spare_parts_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DIALECT=postgres

# --- Auth / JWT ---
JWT_SECRET=change-me-super-secret
JWT_REFRESH_SECRET=change-me-super-secret-refresh
JWT_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_REFRESH_EXPIRES_IN_MS=604800000

# --- Super admin seed ---
SUPER_ADMIN_EMAIL=admin@spareparts.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

# --- OTP (stubbed provider) ---
OTP_EXPIRY_MINUTES=10
OTP_PROVIDER=console

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Shipping (Shiprocket-style) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- Misc ---
COD_MAX_AMOUNT_PAISE=500000
